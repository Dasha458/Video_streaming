# Copy to Docker/.env and fill in. Only the infrastructure bootstrap lives
# here -- application secrets (JWT, GitHub OAuth, S3/ES/Redis/RabbitMQ
# credentials the backend uses) are read from Vault, not from this file.

# ── Profile ───────────────────────────────────────────────────────────────
# DEV ONLY. Adds docker-compose.dev.yml, which exposes Swagger, the MinIO
# console, RabbitMQ management, Grafana, Prometheus and the Vault UI/API on
# the gateway (see "Доступ до сервісів" in the README). Delete this line in
# production: without it those routes do not exist on the public host.
# COMPOSE_PATH_SEPARATOR makes the ":" list work on Windows too (default there is ";").
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
VIDEO_DB=video_streaming

# ── MinIO (S3-compatible object storage) ──────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_REGION_NAME=us-east-1

# ── Elasticsearch ─────────────────────────────────────────────────────────
CLUSTER_NAME=video-streaming
ELASTIC_PASSWORD=change-me
# self-generated license type: basic | trial
LICENSE=basic

# ── HashiCorp Vault ───────────────────────────────────────────────────────
# VAULT_ADDR is what the bff container uses to reach Vault.
VAULT_ADDR=http://vault:8200
# The three values below come from `vault operator init` on first start
# (see vault/config/unseal.sh). Leave blank on a fresh install, run init,
# then paste them here and restart the vault + bff containers.
VAULT_TOKEN=
VAULT_UNSEAL_KEY_1=
VAULT_UNSEAL_KEY_2=
