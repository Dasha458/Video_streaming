      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "videodb"
          },
          "rawSql": "SELECT count(DISTINCT viewer_key) AS \"viewers\" FROM video_views",
          "format": "table",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "description": "Distinct viewer_key: a signed-in user, or an anonymous fingerprint. The honest denominator for engagement.",
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "title": "Storage used",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "videodb"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "videodb"
          },
          "rawSql": "SELECT coalesce(sum(size), 0) AS \"bytes\" FROM videos",
          "format": "table",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1
        },
        "overrides": []
      },
      "description": "Sum of the size column -- what the platform believes it stores. Compare with free space on the Infrastructure board.",
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "title": "Watch time",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "videodb"
      },
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "videodb"
          },
          "rawSql": "SELECT coalesce(sum(watched_seconds), 0) AS \"seconds\" FROM video_watch_sessions",
          "format": "table",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "description": "Seconds actually watched, summed from watch sessions. The number a video platform lives or dies by.",
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Growth",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "title": "Videos uploaded",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "videodb"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "videodb"
          },
          "rawSql": "SELECT $__timeGroupAlias(created_at, $__interval), count(*) AS \"uploads\"\nFROM videos\nWHERE $__timeFilter(created_at)\nGROUP BY 1\nORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "description": "Straight from the table the application writes. No metric had to be added for this.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "New users",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "videodb"
      },
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "videodb"
          },
          "rawSql": "SELECT $__timeGroupAlias(created_at, $__interval), count(*) AS \"signups\"\nFROM users\nWHERE $__timeFilter(created_at)\nGROUP BY 1\nORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "title": "Views",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "videodb"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "videodb"
          },
          "rawSql": "SELECT $__timeGroupAlias(viewed_at, $__interval), count(*) AS \"views\",\n       count(DISTINCT viewer_key) AS \"unique viewers\"\nFROM video_views\nWHERE $__timeFilter(viewed_at)\nGROUP BY 1\nORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "description": "Both lines together: the gap between them is how much of the traffic is the same people coming back.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Pipeline",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "title": "Videos by status",
      "type": "piechart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "videodb"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "videodb"
          },
          "rawSql": "SELECT s.value AS \"status\", count(v.id) AS \"videos\"\nFROM video_statuses s\nLEFT JOIN videos v ON v.status_id = s.id\nGROUP BY 1\nORDER BY 2 DESC",
          "format": "table",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "The encoding pipeline as the database sees it. A growing queued or processing slice here, with the Transcoding board quiet, means jobs are not reaching the worker at all.",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value"
          ]
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      }
    },
    {
      "id": 14,
      "title": "Stuck in the pipeline",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "videodb"
      },
      "gridPos": {
        "x": 6,
        "y": 13,
        "w": 10,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "videodb"
          },
          "rawSql": "SELECT v.name AS \"video\", s.value AS \"status\",\n       date_trunc('second', now() - v.created_at)::text AS \"waiting\"\nFROM videos v\nJOIN video_statuses s ON s.id = v.status_id\nWHERE s.value IN ('queued', 'processing', 'failed')\nORDER BY v.created_at\nLIMIT 20",
          "format": "table",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Named, not counted. A row that has been waiting for hours is the one to go and look at.",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      }
    },
    {
      "id": 15,
      "title": "Videos by privacy",
      "type": "bargauge",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "videodb"
      },
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "videodb"
          },
          "rawSql": "SELECT p.name AS \"privacy\", count(v.id) AS \"videos\"\nFROM privacy_statuses p\nLEFT JOIN videos v ON v.privacy_id = p.id\nGROUP BY 1\nORDER BY 2 DESC",
          "format": "table",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      }
    },
    {
      "id": 16,
      "type": "row",
      "title": "Audience",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 17,
      "title": "Top videos",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "videodb"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "videodb"
          },
          "rawSql": "SELECT v.name AS \"video\", c.name AS \"channel\", v.views_count AS \"views\",\n       v.likes_count AS \"likes\", v.dislikes_count AS \"dislikes\"\nFROM videos v\nLEFT JOIN channels c ON c.id = v.channel_id\nORDER BY v.views_count DESC NULLS LAST\nLIMIT 10",
          "format": "table",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      }
    },
    {
      "id": 18,
      "title": "Top channels",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "videodb"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "videodb"
          },
          "rawSql": "SELECT c.name AS \"channel\", c.subscribers_count AS \"subscribers\",\n       c.views_count AS \"views\", count(v.id) AS \"videos\"\nFROM channels c\nLEFT JOIN videos v ON v.channel_id = c.id\nGROUP BY c.id, c.name, c.subscribers_count, c.views_count\nORDER BY c.subscribers_count DESC NULLS LAST\nLIMIT 10",
          "format": "table",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      }
    },
    {
      "id": 19,
      "title": "Where views come from",
      "type": "piechart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "videodb"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "videodb"
          },
          "rawSql": "SELECT coalesce(source_type, 'unknown') AS \"source\", count(*) AS \"views\"\nFROM video_views\nWHERE $__timeFilter(viewed_at)\nGROUP BY 1\nORDER BY 2 DESC",
          "format": "table",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Search, recommendations, a direct link. Tells you which part of the product is actually bringing people to a video.",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value"
          ]
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      }
    },
    {
      "id": 20,
      "title": "How much of a video gets watched",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "videodb"
      },
      "gridPos": {
        "x": 8,
        "y": 29,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "videodb"
          },
          "rawSql": "SELECT $__timeGroupAlias(started_at, $__interval),\n       avg(completed_percent) AS \"average completion\"\nFROM video_watch_sessions\nWHERE $__timeFilter(started_at)\nGROUP BY 1\nORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "description": "Average completion per session. Stored as a percentage, 0 to 100 -- a figure that once disagreed with its own test fixture.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 21,
      "title": "Signed in vs anonymous",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "videodb"
      },
      "gridPos": {
        "x": 16,
        "y": 29,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "videodb"
          },
          "rawSql": "SELECT CASE WHEN user_id IS NULL THEN 'anonymous' ELSE 'signed in' END AS \"viewer\",\n       count(*) AS \"views\",\n       count(DISTINCT viewer_key) AS \"unique\"\nFROM video_views\nWHERE $__timeFilter(viewed_at)\nGROUP BY 1\nORDER BY 2 DESC",
          "format": "table",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "How much of the audience never signs in. Decides how much product sits behind a login.",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      }
    },
    {
      "id": 22,
      "title": "Comments",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "videodb"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "videodb"
          },
          "rawSql": "SELECT $__timeGroupAlias(created_at, $__interval), count(*) AS \"comments\"\nFROM comments\nWHERE $__timeFilter(created_at)\nGROUP BY 1\nORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
